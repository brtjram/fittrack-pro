# Database
# Local development: use SQLite
DATABASE_URL="file:./dev.db"
# Production (Turso): use libsql:// URL
# DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# Auth.js / NextAuth.js
# Generate a secret: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Google OAuth (optional - leave empty to disable Google sign-in)
# Create credentials at: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Trust the host header (required for Vercel deployment)
AUTH_TRUST_HOST=true

# USDA FoodData Central API (optional - uses DEMO_KEY if not set)
# Get a free key at: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY="yLwPrSaHaR8yCXTVByW8mDGkI4p671jiHtjM3YfB"
