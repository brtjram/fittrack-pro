# Auth.js / NextAuth
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth credentials
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# PostgreSQL connection string used for users table
# Example (local): postgres://postgres:postgres@localhost:5432/sales_co_pilot
AUTH_DB_URL=postgres://postgres:postgres@localhost:5432/sales_co_pilot
