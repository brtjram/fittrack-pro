generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  accounts       Account[]
  sessions       Session[]

  fitnessProfile       FitnessProfile?
  workoutSessions      WorkoutSession[]
  personalRecords      PersonalRecord[]
  foodLogEntries       FoodLogEntry[]
  nutritionAdjustments NutritionAdjustment[]
  weightEntries        WeightEntry[]
  dailyActivities      DailyActivity[]
  pushTokens           PushToken[]
  notificationPrefs    NotificationPreferences?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== Fitness Data Models ====================

model FitnessProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  name            String
  age             Int
  gender          String
  heightCm        Float
  currentWeightLbs Float
  targetWeightLbs  Float
  activityLevel   String
  goal            String
  experienceLevel String
  preferredSplit  String
  healthSyncApiKey String?
  trackCycle      Boolean  @default(false)
  cycleLength     Int?
  lastPeriodDate  String?
  stepTarget      Int      @default(10000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkoutSession {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String   @unique
  date        String
  name        String
  splitDay    String
  exercises   String   // JSON string
  duration    Int?
  completed   Boolean  @default(false)
  weekNumber  Int      @default(1)
  isDeload    Boolean  @default(false)
  notes       String?
  rating      Int?
  cardioLog   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model PersonalRecord {
  id           String   @id @default(cuid())
  userId       String
  exerciseId   String
  exerciseName String
  weight       Float
  reps         Int
  date         String
  sessionId    String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId])
}

model FoodLogEntry {
  id          String   @id @default(cuid())
  userId      String
  date        String
  foodItemId  String
  foodName    String
  servings    Float
  servingSizeG Float
  meal        String
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  fiber       Float?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model NutritionAdjustment {
  id                String   @id @default(cuid())
  userId            String
  date              String
  previousCalories  Float
  newCalories       Float
  reason            String
  weeklyWeightChange Float
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model WeightEntry {
  id             String   @id @default(cuid())
  userId         String
  date           String
  weightLbs      Float
  bodyFatPercent Float?
  note           String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model DailyActivity {
  id              String   @id @default(cuid())
  userId          String
  date            String
  steps           Int
  activeCalories  Int
  restingHeartRate Int?
  source          String   @default("manual")
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("ios")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  enabled               Boolean  @default(true)
  workoutReminder       Boolean  @default(true)
  workoutReminderHour   Int      @default(9)
  workoutReminderMinute Int      @default(0)
  breakfastReminder     Boolean  @default(true)
  breakfastHour         Int      @default(8)
  breakfastMinute       Int      @default(0)
  lunchReminder         Boolean  @default(true)
  lunchHour             Int      @default(12)
  lunchMinute           Int      @default(0)
  dinnerReminder        Boolean  @default(true)
  dinnerHour            Int      @default(18)
  dinnerMinute          Int      @default(0)
  weighInReminder       Boolean  @default(true)
  weighInDay            Int      @default(1)
  weighInHour           Int      @default(8)
  weighInMinute         Int      @default(0)
  quietHoursEnabled     Boolean  @default(false)
  quietHoursStart       Int      @default(22)
  quietHoursEnd         Int      @default(7)
  stepReminder          Boolean  @default(false)
  stepReminderHour      Int      @default(20)
  stepReminderMinute    Int      @default(0)
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
